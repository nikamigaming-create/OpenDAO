+static const GFF32::Field* gffField(const GFF32::Structure* st, const char* name) {
+    return st ? st->getField(name) : nullptr;
+}
+
+template <typename T>
+static const T* gffValue(const GFF32::Field* field) {
+    return field ? std::get_if<T>(&field->value) : nullptr;
+}
+
+static std::string gffString(const GFF32::Structure* st, const char* name) {
+    const auto* value = gffValue<std::string>(gffField(st, name));
+    return value ? *value : std::string();
+}
+
+static int gffInt(const GFF32::Structure* st, const char* name, int fallback = 0) {
+    const auto* field = gffField(st, name);
+    if (!field) return fallback;
+    if (const auto* value = std::get_if<int32_t>(&field->value)) return *value;
+    if (const auto* value = std::get_if<uint32_t>(&field->value)) return (int)*value;
+    if (const auto* value = std::get_if<uint8_t>(&field->value)) return (int)*value;
+    return fallback;
+}
+
+static int findPart(const std::vector<std::pair<std::string, std::string>>& parts,
+                    const std::string& file) {
+    std::string wanted = file;
+    std::transform(wanted.begin(), wanted.end(), wanted.begin(), ::tolower);
+    for (size_t i = 0; i < parts.size(); i++) {
+        std::string candidate = parts[i].first;
+        std::transform(candidate.begin(), candidate.end(), candidate.begin(), ::tolower);
+        if (candidate == wanted) return (int)i;
+    }
+    return -1;
+}
