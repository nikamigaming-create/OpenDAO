+
+bool loadMMHPointLights(const std::vector<uint8_t>& data, std::vector<AuthoredLight>& lights) {
+    GFFFile gff;
+    if (!gff.load(data) || gff.structs().empty()) return false;
+
+    struct Transform {
+        float px = 0, py = 0, pz = 0;
+        float qx = 0, qy = 0, qz = 0, qw = 1;
+    };
+    auto normalize = [](Transform& t) {
+        const float n = std::sqrt(t.qx*t.qx + t.qy*t.qy + t.qz*t.qz + t.qw*t.qw);
+        if (n > 0.00001f) { t.qx /= n; t.qy /= n; t.qz /= n; t.qw /= n; }
+        else { t.qx = t.qy = t.qz = 0; t.qw = 1; }
+    };
+    auto rotate = [](const Transform& t, float x, float y, float z, float& ox, float& oy, float& oz) {
+        const float tx = 2.0f * (t.qy*z - t.qz*y);
+        const float ty = 2.0f * (t.qz*x - t.qx*z);
+        const float tz = 2.0f * (t.qx*y - t.qy*x);
+        ox = x + t.qw*tx + (t.qy*tz - t.qz*ty);
+        oy = y + t.qw*ty + (t.qz*tx - t.qx*tz);
+        oz = z + t.qw*tz + (t.qx*ty - t.qy*tx);
+    };
+    auto compose = [&](const Transform& parent, const Transform& local) {
+        Transform out;
+        float rx, ry, rz;
+        rotate(parent, local.px, local.py, local.pz, rx, ry, rz);
+        out.px = parent.px + rx; out.py = parent.py + ry; out.pz = parent.pz + rz;
+        out.qx = parent.qw*local.qx + parent.qx*local.qw + parent.qy*local.qz - parent.qz*local.qy;
+        out.qy = parent.qw*local.qy - parent.qx*local.qz + parent.qy*local.qw + parent.qz*local.qx;
+        out.qz = parent.qw*local.qz + parent.qx*local.qy - parent.qy*local.qx + parent.qz*local.qw;
+        out.qw = parent.qw*local.qw - parent.qx*local.qx - parent.qy*local.qy - parent.qz*local.qz;
+        normalize(out);
+        return out;
+    };
+    auto readVec = [&](const GFFStructRef& ref, uint32_t label, float* out, int count) {
+        const GFFField* f = gff.findField(ref.structIndex, label);
+        if (!f) return false;
+        const uint32_t p = gff.dataOffset() + f->dataOffset + ref.offset;
+        for (int i = 0; i < count; ++i) out[i] = gff.readFloatAt(p + i*4);
+        return true;
+    };
+
+    std::function<void(GFFStructRef, const Transform&)> visit;
+    visit = [&](GFFStructRef ref, const Transform& parent) {
+        if (ref.structIndex >= gff.structs().size()) return;
+        const auto children = gff.readStructList(ref.structIndex, 6999, ref.offset);
+        Transform local;
+        for (const auto& child : children) {
+            if (child.structIndex >= gff.structs().size()) continue;
+            const std::string type(gff.structs()[child.structIndex].structType, 4);
+            if (type == "trsl") {
+                float p[3] = {};
+                if (readVec(child, 6047, p, 3)) { local.px = p[0]; local.py = p[1]; local.pz = p[2]; }
+            } else if (type == "rota") {
+                float q[4] = {0,0,0,1};
+                if (readVec(child, 6048, q, 4)) { local.qx=q[0]; local.qy=q[1]; local.qz=q[2]; local.qw=q[3]; }
+            }
+        }
+        normalize(local);
+        const Transform world = compose(parent, local);
+        std::string ownerName = gff.readStringByLabel(ref.structIndex, 6000, ref.offset);
+        const std::string currentType(gff.structs()[ref.structIndex].structType, 4);
+        if (currentType == "nplt") {
+            AuthoredLight light;
+            light.name = ownerName;
+            light.px=world.px; light.py=world.py; light.pz=world.pz;
+            light.qx=world.qx; light.qy=world.qy; light.qz=world.qz; light.qw=world.qw;
+            readVec(ref, 6007, light.color, 4);
+            light.radius = gff.readFloatByLabel(ref.structIndex, 6008, ref.offset);
+            light.intensityVariation = gff.readFloatByLabel(ref.structIndex, 6249, ref.offset);
+            light.intensityPeriod = gff.readFloatByLabel(ref.structIndex, 6250, ref.offset);
+            light.intensityPeriodDelta = gff.readFloatByLabel(ref.structIndex, 6251, ref.offset);
+            const GFFField* staticField = gff.findField(ref.structIndex, 6009);
+            if (staticField) light.isStatic = gff.readUInt8At(gff.dataOffset() + staticField->dataOffset + ref.offset) != 0;
+            const GFFField* occField = gff.findField(ref.structIndex, 6339);
+            if (occField) light.canBeOccluded = gff.readUInt8At(gff.dataOffset() + occField->dataOffset + ref.offset) != 0;
+            if (light.radius > 0.01f) lights.push_back(std::move(light));
+        }
+        for (const auto& child : children) {
+            if (child.structIndex >= gff.structs().size()) continue;
+            const std::string type(gff.structs()[child.structIndex].structType, 4);
+            if (type == "node" || type == "nplt") visit(child, world);
+        }
+    };
+    visit({0, 0}, Transform{});
+    return !lights.empty();
+}
